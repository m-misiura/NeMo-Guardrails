ARG BASE="quay.io/aipcc/base-images/cpu-el9.8:3.6.0-ea.2-1788562451@sha256:5dbe6a3e14877ef9fbda55e6cef66430a244c6a5c73a9a72bfef5b3af31e44c5"

ARG MODELCAR_MINILM=registry.redhat.io/rhai/modelcar-redhatai-all-minilm-l6-v2:3.0
ARG MODELCAR_SNOWFLAKE=registry.redhat.io/rhai/modelcar-redhatai-snowflake-arctic-embed-m-long:3.0
ARG MODELCAR_SPACY=registry.redhat.io/rhai/modelcar-redhatai-en-core-web-lg:3.0
ARG MODELCAR_NLTK=registry.redhat.io/rhai/modelcar-redhatai-nltk-punkt-tab:3.0
ARG MODELCAR_DEBERTA=registry.redhat.io/rhai/modelcar-redhatai-deberta-v3-base-prompt-injection-v2:3.0
ARG MODELCAR_HAP=registry.redhat.io/rhai/modelcar-redhatai-granite-guardian-hap-125m:3.0

FROM ${MODELCAR_MINILM} AS modelcar-minilm
FROM ${MODELCAR_SNOWFLAKE} AS modelcar-snowflake
FROM ${MODELCAR_SPACY} AS modelcar-spacy
FROM ${MODELCAR_NLTK} AS modelcar-nltk
FROM ${MODELCAR_DEBERTA} AS modelcar-deberta
FROM ${MODELCAR_HAP} AS modelcar-hap

FROM ${BASE} as build

USER 0
WORKDIR /app

ARG GUARDRAILS_PROFILE=opensource

COPY requirements.txt requirements-build.txt pyproject.toml README.md LICENSE* LICENCES* ./

COPY nemoguardrails/ ./nemoguardrails/
COPY scripts/ ./scripts/
COPY examples/bots/ ./examples/bots/

RUN chmod +x ./scripts/entrypoint.sh
RUN pip install --no-cache-dir pyyaml
RUN python3 ./scripts/filter_guardrails.py ./scripts/provider-list.yaml $GUARDRAILS_PROFILE

ENV HF_HOME=/app/.cache/huggingface \
    TRANSFORMERS_CACHE=/app/.cache/transformers \
    SENTENCE_TRANSFORMERS_HOME=/app/.cache/sentence_transformers \
    NLTK_DATA=/app/.cache/nltk_data \
    FASTEMBED_CACHE_PATH=/app/.cache/fastembed

COPY --from=modelcar-minilm /models /tmp/modelcars/minilm
COPY --from=modelcar-snowflake /models /tmp/modelcars/snowflake
COPY --from=modelcar-spacy /models/en_core_web_lg-any-py3-none-any.whl /tmp/modelcars/
COPY --from=modelcar-nltk /models /tmp/modelcars/nltk
COPY --from=modelcar-deberta /models /tmp/modelcars/deberta
COPY --from=modelcar-hap /models /tmp/modelcars/hap

RUN python3 -m venv /app/.venv && \
    /app/.venv/bin/pip install --no-cache-dir -r requirements-build.txt && \
    /app/.venv/bin/pip install --no-cache-dir -r requirements.txt && \
    /app/.venv/bin/pip install --no-cache-dir --no-deps /tmp/modelcars/en_core_web_lg-any-py3-none-any.whl && \
    mkdir -p nemoguardrails/examples && \
    cp -r examples/bots nemoguardrails/examples/bots && \
    /app/.venv/bin/pip install --no-cache-dir --no-deps . && \
    rm -rf nemoguardrails/examples /root/.cache/pip /var/tmp/*

RUN set -ex && \
    python3 ./scripts/setup_modelcar_models.py && \
    find /app/.cache -type f -name "*.pyc" -delete && \
    (find /app/.cache -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true) && \
    (find /app/.cache -type d -name ".git" -exec rm -rf {} + 2>/dev/null || true) && \
    rm -rf /app/.cache/huggingface/xet /root/.cache /tmp/* /var/tmp/*

FROM ${BASE} as runtime

USER 0
WORKDIR /app

COPY --from=build /app /app

RUN rm -f /etc/security/namespace.conf /usr/lib64/security/pam_namespace.so || true && \
    chgrp -R 0 /app && \
    chmod -R g=u /app && \
    chmod +x /app/scripts/entrypoint.sh

USER 1001

ENV HF_HOME=/app/.cache/huggingface \
    TRANSFORMERS_CACHE=/app/.cache/transformers \
    SENTENCE_TRANSFORMERS_HOME=/app/.cache/sentence_transformers \
    NLTK_DATA=/app/.cache/nltk_data \
    FASTEMBED_CACHE_PATH=/app/.cache/fastembed \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    DO_NOT_TRACK=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000
ENTRYPOINT ["./scripts/entrypoint.sh"]

LABEL com.redhat.component="odh-nemo-guardrails" \
      name="rhoai/odh-nemo-guardrails-rhel9" \
      description="NeMo Guardrails is an open-source toolkit for easily adding programmable guardrails to LLM-based conversational systems" \
      summary="odh-nemo-guardrails" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.openshift.expose-services="8000:http" \
      io.k8s.display-name="odh-nemo-guardrails" \
      io.k8s.description="NeMo Guardrails toolkit for controlling and securing LLM-based conversational systems" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf"
