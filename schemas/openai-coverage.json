                              },
                              "description": {
                                "from": "Number between -2.0 and 2.0. Positive values penalize new tokens based on\ntheir existing frequency in the text so far, decreasing the model's\nlikelihood to repeat the same line verbatim.\n",
                                "to": "Frequency penalty parameter."
                              },
                              "default": {
